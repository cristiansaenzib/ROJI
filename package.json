{
  "name": "tienda-pedidos",
  "version": "1.0.0",
  "description": "Catálogo, apartados y ventas",
  "author": "Mi Tienda",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-lib.js",
    "start": "electron .",
    "build:win": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.tienda.pedidos",
    "productName": "Tienda Pedidos",
    "files": ["electron/**/*", "www/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@supabase/supabase-js": "2.45.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
